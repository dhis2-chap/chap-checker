# Example chap-checker config. Copy to ./chap-checker.toml and edit.
# `chap-checker verify` (no args) checks every instance below.
# `chap-checker verify --instance <name>` checks just one.
#
# WARNING: this file contains credentials. Keep it out of git and set
# restrictive permissions (chmod 600 chap-checker.toml).

[instances.example]
url = "https://dhis2.example.com"
username = "REPLACE_ME"
password = "REPLACE_ME"

[instances.another-example]
url = "https://dhis2.example.org"
username = "REPLACE_ME"
# Prefer pulling secrets from the environment in shared / CI setups:
password_env = "ANOTHER_EXAMPLE_PASSWORD"

# Optional overrides (shown with their defaults):
# timeout_s = 10.0
# verify_tls = true
# Run only a subset of checks (prereqs are pulled in automatically).
# Run `chap-checker checks list` to see the available names.
# checks = ["dhis2_chap_ping"]

# Optional: alert to Slack when a check's status changes (stateful;
# transitions only). State is persisted to ./chap-checker.state.json
# (or --state <path>) next to this config.
[alerts.slack]
# Use either an inline URL or pull from the environment. Treat the webhook
# URL as a credential.
# webhook_url = "https://hooks.slack.com/services/REPLACE/ME/HERE"
webhook_url_env = "SLACK_WEBHOOK_URL"

# Optional overrides (shown with their defaults):
# notify_on = ["fail", "error", "warn"]
# timeout_s = 10.0
