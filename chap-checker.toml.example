# Example chap-checker config. Copy to ./chap-checker.toml and edit.
# `chap-checker verify` (no args) checks every instance below.
# `chap-checker verify --instance <name>` checks just one.
# `chap-checker checks list` shows every available check name.
#
# WARNING: this file contains credentials. Keep it out of git and set
# restrictive permissions (chmod 600 chap-checker.toml).

# Production instance: opts in to Slack alerts on every transition.
[instances.example]
url = "https://dhis2.example.com"
username = "REPLACE_ME"
password = "REPLACE_ME"
alerts = ["slack"]

# DHIS2-only instance, no alerts:
#  - `checks` restricts to dhis2_* probes (skip every dhis2_chap_* one).
#    Prereqs are pulled in automatically.
#  - `alerts` is omitted, so transitions are tracked in state but never
#    dispatched. Flip to `alerts = ["slack"]` later and the next real
#    transition will fire normally - no spurious "first failure" alerts.
[instances.dhis2-only-example]
url = "https://dhis2.example.org"
username = "REPLACE_ME"
# Prefer pulling secrets from the environment in shared / CI setups:
password_env = "ANOTHER_EXAMPLE_PASSWORD"
checks = ["dhis2_ping", "dhis2_system_info"]

# Token-based auth (DHIS2 Personal Access Token). Mutually exclusive
# with `password` / `password_env` on the same instance. The token is
# sent as `Authorization: ApiToken <value>`; `username` is optional
# in token mode.
[instances.token-example]
url = "https://dhis2.example.net"
# Inline (NOT recommended for shared files):
# token = "REPLACE_ME"
# Recommended:
token_env = "EXAMPLE_DHIS2_TOKEN"

# Optional per-instance overrides (shown with their defaults):
# timeout_s = 10.0
# verify_tls = true

# Optional retries on transient transport failures + 429/502/503/504. Off by
# default: a health checker generally wants to observe flakes rather than
# mask them. Opt in here for the whole config, or per instance via
# `retry_policy = { ... }`.
# [retry]
# max_attempts = 3
# base_delay = 0.5
# max_delay = 30.0
# backoff_factor = 2.0
# jitter = 0.1
# retry_statuses = [429, 502, 503, 504]

# Optional: alert to Slack when a check's status flips between OK and a non-OK
# status. State is persisted to ./chap-checker.state.json (override with
# --state <path>) next to this config.
[alerts.slack]
# Use either an inline URL or pull from the environment. Treat the webhook
# URL as a credential.
# webhook_url = "https://hooks.slack.com/services/REPLACE/ME/HERE"
webhook_url_env = "SLACK_WEBHOOK_URL"

# Optional overrides (shown with their defaults):
# notify_on = ["fail", "error", "warn"]
# timeout_s = 10.0

# Generic webhook alerter: POST the canonical chap-checker JSON envelope to
# any URL that accepts application/json. Use this to wire PagerDuty Events,
# OpsGenie, an internal incident bus, or anything else not (yet) covered by
# a dedicated alerter. Run `chap-checker alerts list` for a copy-paste TOML
# snippet with field-by-field comments.
# [alerts.webhook]
# url_env = "MY_WEBHOOK_URL"
# notify_on = ["fail", "error", "warn"]
# timeout_s = 10.0
# headers = { "Authorization" = "Bearer ..." }

# Optional bearer-token auth for `chap-checker serve` ONLY. The block
# gates the daemon's /api/state and /api/reload over HTTP - it has no
# effect on `chap-checker verify` or local `chap-checker tui`, both of
# which talk straight to DHIS2 from your terminal and aren't network-
# reachable. Browser users get a built-in login modal; remote TUI
# clients pass `tui --connect URL --token-env CHAP_CHECKER_TOKEN`.
# Generate a token with `openssl rand -hex 32`. Rotation = update the
# env var, restart serve.
# [auth]
# token_env = "CHAP_CHECKER_TOKEN"

# Optional UI branding + theme, shown in both the Textual TUI header and
# the browser dashboard. The browser's command palette (Ctrl+K / Cmd+K)
# also exposes the theme at runtime; the config value here is the
# *starting default* - a per-user pick (persisted in browser localStorage)
# wins until cleared.
# [ui]
# title = "DHIS2 / Climate Instance Checker"   # default; 1-120 chars
# theme = "phosphor"                           # phosphor | amber | high | tokyo | dhis2
